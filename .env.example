# Copy to .env for local use only. Do not commit real credentials or raw data.

# SEC requires a descriptive User-Agent for API requests.
SEC_USER_AGENT="Your Name your.email@example.com"

# Optional local CSV provider paths.
SHARADAR_TICKERS_CSV="/path/to/tickers.csv"
SHARADAR_STOCKS_CSV="/path/to/stocks.csv"
SHARADAR_FUNDS_CSV="/path/to/funds.csv"
SHARADAR_FUNDAMENTALS_CSV="/path/to/fundamentals.csv"
SHARADAR_DAILY_CSV="/path/to/daily.csv"
SHARADAR_ACTIONS_CSV="/path/to/actions.csv"
